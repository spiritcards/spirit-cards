# Spirit Cards — web env (copy to .env.local)
# Robinhood Chain (MAINNET default since t9, 2026-10-05; testnet = chainId 46630)

NEXT_PUBLIC_RH_CHAIN_ID=4663
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_RH_IS_TESTNET=false

# Canonical public URL (sitemap / llms.txt / JSON-LD / OpenAPI)
NEXT_PUBLIC_SITE_URL=https://spiritcards.fun

# Core contract override (default from lib/canonical.ts)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0997DB0BEa2c1278063ebBEc0d1cdbecE7B6F021

# Deterministic preview cards while the collection is empty (0 = off)
NEXT_PUBLIC_PREVIEW_CAP=24

# Official project links (defaults live in lib/site.ts)
NEXT_PUBLIC_GITHUB_URL=https://github.com/spiritcards
NEXT_PUBLIC_X_URL=https://x.com/spirit_card
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/spirit_cards_game
NEXT_PUBLIC_OPENSEA_URL=https://opensea.io/collection/spirit-cards

# WalletConnect (Reown) project id — optional, enables mobile QR pairing
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Rough ETH→USD rate for illustrative "$" labels (battle stake etc.); not a feed
NEXT_PUBLIC_ETH_USD=3000
